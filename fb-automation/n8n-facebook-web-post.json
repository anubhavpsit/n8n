{
  "name": "Daily Facebook Post (Web Automation)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10
            }
          ]
        }
      },
      "id": "p1",
      "name": "Every Day 10 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "change-me-secret"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "id": "p2",
      "name": "Check Facebook Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.loggedIn }}",
              "value2": true
            }
          ]
        }
      },
      "id": "p3",
      "name": "Logged In?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "fileSelector": "REPLACE_WITH_FULL_PATH/.n8n-files/posts.csv",
        "options": {}
      },
      "id": "p4",
      "name": "Read Posts CSV",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        660,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "csv",
        "options": {
          "headerRow": true
        }
      },
      "id": "p5",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' }); // YYYY-MM-DD\n\nfunction normalize(d) {\n  d = String(d || '').trim();\n  const m = d.match(/^(\\d{1,2})[-\\/](\\d{1,2})[-\\/](\\d{4})$/); // DD-MM-YYYY or DD/MM/YYYY\n  if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;\n  return d;\n}\n\nconst out = [];\nfor (const item of $input.all()) {\n  if (normalize(item.json.date) !== today) continue;\n  const message = String(item.json.message || '').trim();\n  const image = String(item.json.image || '').trim();\n  const target_url = String(item.json.target_url || '').trim();\n  if (!message && !image) continue;\n  out.push({ json: { message, image, target_url } });\n}\nreturn out; // nothing for today = workflow stops quietly"
      },
      "id": "p6",
      "name": "Pick Today's Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "p7",
      "name": "Loop Posts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/post",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "change-me-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $json.message, image: $json.image, target_url: $json.target_url }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "p8",
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 120) + 60 }}",
        "unit": "seconds"
      },
      "id": "p9",
      "name": "Random Wait 1-3 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        0
      ],
      "webhookId": "d1e2f3a4-0000-4000-8000-000000000003"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_GMAIL@gmail.com",
        "toEmail": "YOUR_GMAIL@gmail.com",
        "subject": "⚠️ Facebook bot needs login - today's posts NOT published",
        "emailFormat": "text",
        "text": "Hi,\n\nThe Facebook bot was not logged in (or not running) at {{ $now.setZone('Asia/Kolkata').toFormat('dd LLL yyyy, hh:mm a') }}.\nToday's scheduled posts were NOT published.\n\nHow to fix:\n1. Open WSL and run: pm2 status  (fb-bot should be 'online'; if not: pm2 restart fb-bot)\n2. See what Facebook is showing: http://localhost:3001/screen.png?key=change-me-secret\n3. Log in again:\n   Option A: pm2 stop fb-bot, then in fb-bot folder: HEADLESS=false node server.js -> log in -> Ctrl+C -> pm2 start fb-bot\n   Option B: export fresh cookies with Cookie-Editor and POST them to http://localhost:3001/cookies\n4. Confirm at http://localhost:3001/status?key=change-me-secret\n5. Re-run the workflow in n8n to publish today's posts.\n\nDetails: {{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "email-login-alert",
      "name": "Email Login Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        150
      ]
    }
  ],
  "connections": {
    "Every Day 10 AM": {
      "main": [
        [
          {
            "node": "Check Facebook Login",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Facebook Login": {
      "main": [
        [
          {
            "node": "Logged In?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Logged In?": {
      "main": [
        [
          {
            "node": "Read Posts CSV",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email Login Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Posts CSV": {
      "main": [
        [
          {
            "node": "Parse CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse CSV": {
      "main": [
        [
          {
            "node": "Pick Today's Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick Today's Posts": {
      "main": [
        [
          {
            "node": "Loop Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Posts": {
      "main": [
        [],
        [
          {
            "node": "Post to Facebook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Facebook": {
      "main": [
        [
          {
            "node": "Random Wait 1-3 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Random Wait 1-3 min": {
      "main": [
        [
          {
            "node": "Loop Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Kolkata",
    "executionOrder": "v1"
  }
}