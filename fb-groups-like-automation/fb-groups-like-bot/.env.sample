# Copy this file to .env (same folder) and change the values.
# The bot reads .env on startup. Run `pm2 restart fb-groups-like-bot` after editing.
# Values given on the command line (e.g. API_KEY=x node server.js) win over this file.

# Secret every request must send (x-api-key header or ?key=). Use a long random string,
# for example from: openssl rand -hex 16. Must match the key in the n8n workflow.
API_KEY=change-me-to-a-long-random-secret

# Port the bot listens on (n8n calls http://localhost:PORT)
PORT=3005

# false = visible browser window (needed to log in to Facebook the first time)
# true  = hidden browser, for running under pm2 after you are logged in
HEADLESS=false

# Maximum number of posts this bot may like in a single group per calendar day.
# Keeping it low reduces the chance of Facebook flagging the account.
MAX_LIKES_PER_GROUP_PER_DAY=20

# Folder that keeps the logged-in browser session (relative paths are next to server.js).
# Never share or commit it.
SESSION_DIR=./session

# File that tracks how many likes were given per group per day (rate-limiting)
HISTORY_FILE=./like-history.json
